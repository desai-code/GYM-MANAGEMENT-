<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="SiteMaster" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head id="Head1" runat="server">
    <title>Haathi Fitness Admin Centre</title>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <link href="~/Styles/Site.css" rel="stylesheet" type="text/css" />

    <style type="text/css">
        :root {
            --accent: #f2a900;
            --accent-dark: #d99400;
            --ink: #f5f6f8;
            --accent-ink: #8a5f00;
            --text: #16171c;
            --panel: #ffffff;
            --panel-alt: #f3f4f7;
            --muted: #6b6d76;
            --border: #e6e8ec;
            --danger: #dc2626;
            --success: #16a34a;
            --radius: 14px;
        }

        * { box-sizing: border-box; }

        html, body {
            background: var(--ink);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            margin: 0;
            min-height: 100%;
        }

        .page { min-height: 100vh; display: flex; flex-direction: column; }
        .main { flex: 1; }

        /* ---------- Top identity bar ---------- */
        .site-topbar {
            background: var(--ink);
            border-bottom: 1px solid var(--border);
        }

        .site-nav {
            box-shadow: 0 1px 0 rgba(17,24,39,.03);
        }

        .site-topbar .topbar-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 14px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .brand-mark {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .brand-mark .brand-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            background: var(--accent);
            color: #0d0d0f;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            transform: rotate(-3deg);
            box-shadow: 0 6px 16px rgba(255, 212, 0, .25);
            flex-shrink: 0;
        }

        .brand-mark .brand-text h1 {
            font-family: 'Oswald', sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: .05em;
            text-transform: uppercase;
            color: var(--text);
            margin: 0;
            line-height: 1.1;
        }

        .brand-mark .brand-text span {
            font-size: 11px;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--accent-ink);
            font-weight: 600;
        }

        .login-pill {
            font-size: 13px;
            color: var(--muted);
        }

        .login-pill .bold { color: var(--text); font-weight: 600; }

        .login-pill a {
            color: var(--accent-ink);
            text-decoration: none;
            font-weight: 600;
        }

        .login-pill a:hover { color: var(--accent-dark); }

        /* ---------- Nav ---------- */
        .site-nav {
            background: var(--panel) !important;
            border-bottom: 1px solid var(--border);
            padding: 4px 0;
        }

        .site-nav .container-fluid {
            max-width: 1200px;
        }

        .site-nav .navbar-brand img {
            border-radius: 8px;
            border: 2px solid var(--accent);
        }

        .site-nav .navbar-nav {
            gap: 4px;
        }

        .site-nav .nav-link {
            font-family: 'Oswald', sans-serif;
            font-size: 12.5px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #4b4d55 !important;
            padding: 10px 14px !important;
            border-radius: 8px;
            border-bottom: 2px solid transparent;
            transition: color .15s, background .15s, border-color .15s;
        }

        .site-nav .nav-link:hover {
            color: var(--accent) !important;
            background: rgba(255, 212, 0, .08);
        }

        .site-nav .nav-link.active {
            color: var(--accent) !important;
            border-bottom-color: var(--accent-ink);
            background: rgba(255, 212, 0, .08);
        }

        .site-nav .navbar-toggler {
            border-color: var(--border);
        }

        .nav-search { position: relative; }

        .nav-search input {
            background: var(--panel-alt);
            border: 1px solid var(--border);
            color: var(--text);
            border-radius: 10px 0 0 10px;
            font-size: 13px;
        }

        .nav-search input::placeholder { color: #9a9ca6; }

        .nav-search input:focus {
            background: var(--panel-alt);
            border-color: var(--accent-ink);
            box-shadow: none;
            color: var(--text);
        }

        .nav-search button {
            background: var(--accent);
            border: 1px solid var(--accent);
            color: #0d0d0f;
            font-weight: 700;
            border-radius: 0 10px 10px 0;
            font-size: 13px;
        }

        .nav-search button:hover { background: var(--accent-dark); }

        /* 10 menu links + search box must fit in one row on laptop screens */
        @media (min-width: 992px) {
            .site-nav .navbar-nav { gap: 0; }
            .site-nav .nav-link { padding: 8px 7px !important; font-size: 12px; }
            .nav-search input { width: 130px; }
        }

        /* ---------- Footer ---------- */
        .site-footer {
            background: var(--ink);
            border-top: 1px solid var(--border);
            padding: 18px 20px;
            margin-top: 40px;
        }

        .site-footer .footer-inner {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            font-size: 12.5px;
            color: var(--muted);
        }

        .site-footer .footer-accent {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent);
            display: inline-block;
            margin-right: 6px;
        }

        /* ---------- Mobile polish ---------- */
        @media (max-width: 767.98px) {
            .form-control, .form-select { font-size: 16px !important; }
            .grid-wrap { -webkit-overflow-scrolling: touch; }
        }
        @media (max-width: 575.98px) {
            .topbar-inner { flex-wrap: wrap; gap: 6px; }
            .login-pill { width: 100%; font-size: 12.5px; }
            .site-nav .navbar-nav { padding: 8px 0; }
            .site-nav .nav-link { padding: 11px 10px !important; }
            .nav-search { margin: 6px 0 12px; }
            .nav-search input { width: 100%; }
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="Form1" runat="server">
    <div class="page">

        <div class="site-topbar">
            <div class="topbar-inner">
                <a class="brand-mark" href="Default.aspx">
                    <span class="brand-icon"><i class="bi bi-lightning-charge-fill"></i></span>
                    <span class="brand-text">
                        <h1>Haathi Fitness</h1>
                        <span>Admin Centre</span>
                    </span>
                </a>

                <div class="login-pill">
                    Welcome <span class="bold"><asp:Label ID="lblAdminName" runat="server" /></span>
                    [ <asp:LinkButton ID="lnkLogout" runat="server" OnClick="lnkLogout_Click" CausesValidation="false">Log Out</asp:LinkButton> ]
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-light site-nav">
            <div class="container-fluid">
                <a class="navbar-brand" href="Default.aspx">
                    <img src="Image1/IMG-20260303-WA0015.jpg.jpeg" height="38" width="38" alt="Logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mynavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mynavbar">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="Default.aspx"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="Add_admin.aspx"><i class="bi bi-shield-fill-check me-1"></i>Add Admin</a></li>
                        <li class="nav-item"><a class="nav-link" href="Add_member.aspx"><i class="bi bi-person-vcard-fill me-1"></i>Add Member</a></li>
                        <li class="nav-item"><a class="nav-link" href="Add_membership_plan.aspx"><i class="bi bi-clipboard2-check-fill me-1"></i>Membership Plan</a></li>
                        <li class="nav-item"><a class="nav-link" href="Add_trainer_Info.aspx"><i class="bi bi-person-badge-fill me-1"></i>Trainer Info</a></li>
                        <li class="nav-item"><a class="nav-link" href="Add_program.aspx"><i class="bi bi-activity me-1"></i>Workout Programs</a></li>
                        <li class="nav-item"><a class="nav-link" href="Add_supplement.aspx"><i class="bi bi-basket2-fill me-1"></i>Supplements</a></li>
                        <li class="nav-item"><a class="nav-link" href="Bookings.aspx"><i class="bi bi-calendar2-check-fill me-1"></i>Bookings</a></li>
                        <li class="nav-item"><a class="nav-link" href="Change_password.aspx"><i class="bi bi-shield-lock-fill me-1"></i>Change Password</a></li>
                        <li class="nav-item"><a class="nav-link" href="About.aspx"><i class="bi bi-info-circle-fill me-1"></i>About</a></li>
                        <li class="nav-item"><a class="nav-link" href="client/index.aspx" target="_blank"><i class="bi bi-globe2 me-1"></i>Client Side</a></li>
                    </ul>
                    <div class="d-flex nav-search" role="search">
                        <input id="navSearchBox" class="form-control" type="text" placeholder="Search members..." onkeydown="if(event.key==='Enter'){event.preventDefault();navSearch();}">
                        <button class="btn" type="button" onclick="navSearch()"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </div>
        </nav>

        <div class="main">
            <div id="adminMsgHost" style="max-width:980px;margin:16px auto 0;padding:0 16px;"></div>
            <asp:ContentPlaceHolder ID="MainContent" runat="server"/>
        </div>

    </div>
    <div class="site-footer">
        <div class="footer-inner">
            <div><span class="footer-accent"></span>© <%= DateTime.Now.Year %> Haathi Fitness — Admin Centre</div>
            <div>Built for strength. Managed with precision.</div>
        </div>
    </div>
    </form>
    <script>
        function showAdminMsg(text, kind) {
            var host = document.getElementById('adminMsgHost');
            if (!host) return;
            var d = document.createElement('div');
            d.className = 'alert alert-' + kind + ' alert-dismissible fade show mb-0';
            d.setAttribute('role', 'alert');
            d.appendChild(document.createTextNode(text));
            var b = document.createElement('button');
            b.type = 'button'; b.className = 'btn-close'; b.setAttribute('data-bs-dismiss', 'alert');
            d.appendChild(b);
            host.innerHTML = '';
            host.appendChild(d);
            if (kind === 'success') setTimeout(function () { if (d.parentNode) d.parentNode.removeChild(d); }, 6000);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
        function navSearch() {
            var q = document.getElementById('navSearchBox').value.replace(/^\s+|\s+$/g, '');
            window.location.href = 'Add_member.aspx' + (q ? '?q=' + encodeURIComponent(q) : '');
        }
    </script>
</body>
</html>
