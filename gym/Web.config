<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <!-- Only the file location lives here. The provider (ACE / Jet) is chosen automatically by App_Code/DbHelper.cs.
         |DataDirectory| = this site's App_Data folder, so it works on any PC / server. -->
    <add name="GymDb" connectionString="Data Source=|DataDirectory|\projectdatabase.mdb" providerName="System.Data.OleDb"/>
  </connectionStrings>
  <appSettings>
    <!-- Every new supplement order is e-mailed here -->
    <add key="OrderNotifyTo" value="hathifitnessstudio@gmail.com"/>
  </appSettings>
  <system.net>
    <mailSettings>
      <!-- Gmail SMTP. password = Google "App Password" (16 letters), NOT your normal Gmail password -->
      <smtp from="hathifitnessstudio@gmail.com" deliveryMethod="Network">
        <network host="smtp.gmail.com" port="587" enableSsl="true"
                 userName="hathifitnessstudio@gmail.com" password="wrbkeykblakcscjk"/>
      </smtp>
    </mailSettings>
  </system.net>
  <system.web>
    <!-- LIVE SERVER: debug must stay false -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8"/>
    <compilation debug="false" targetFramework="4.0"/>
    <!-- Admin login is handled by login.aspx + Session (see Site.master.cs), not by ASP.NET Membership/SQL Express -->
    <authentication mode="None"/>
    <sessionState mode="InProc" timeout="30" cookieless="false"/>
    <httpCookies httpOnlyCookies="true"/>
    <httpRuntime maxRequestLength="4096" executionTimeout="60"/>
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.html"/>
    <pages validateRequest="true" enableEventValidation="true"/>
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true"/>
  </system.webServer>
</configuration>
